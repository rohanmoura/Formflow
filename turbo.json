{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "!.turbo/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "@formflow/db#build": {
      "cache": false
    },
    "@formflow/db#typecheck": {
      "dependsOn": ["build"]
    },
    "@formflow/web#dev": {
      "dependsOn": ["@formflow/validation#build"]
    }
  },
  "globalPassThroughEnv": ["DATABASE_URL", "APP_URL", "CLERK_PUBLISHABLE_KEY", "CLERK_SECRET_KEY"]
}
